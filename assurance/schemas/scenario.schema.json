{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assurance/scenario.schema.json",
  "title": "AssuranceScenario",
  "type": "object",
  "required": [
    "scenario_id",
    "seed",
    "transport",
    "tasks",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "transport": {
      "enum": [
        "mock",
        "ros2action",
        "workbench",
        "traceartifact",
        "socketcan"
      ]
    },
    "sut_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "epoch",
          "resource",
          "deadline_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "epoch": {
            "type": "integer",
            "minimum": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "deadline_ms": {
            "type": "integer",
            "minimum": 1
          },
          "expect": {
            "enum": [
              "done",
              "rejected",
              "cancelled",
              "timeout"
            ]
          },
          "start_after_ms": {
            "type": "integer",
            "minimum": 0
          },
          "sut_scenario": {
            "type": "string",
            "minLength": 1,
            "description": "registered id in the SUT's own registry, e.g. normal-001"
          },
          "runner": {
            "type": "string",
            "enum": [
              "scripted",
              "external",
              "gazebo"
            ]
          }
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "task_id"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "drop_ack",
              "delay_ack",
              "kill_sut",
              "task_timeout",
              "claim_conflict",
              "stale_ack"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "delay_ms": {
            "type": "integer",
            "minimum": 0
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "kind",
          "requires"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "registered_scenario",
              "no_false_success",
              "terminal_state",
              "ack_matches_task",
              "conflict_rejected",
              "no_ack_after_exit",
              "late_ack_recorded",
              "cancel_then_stop",
              "no_late_completion",
              "bundle_published",
              "kill_observed",
              "trace_artifact_verified",
              "raw_command_refused",
              "no_staging_residue"
            ]
          },
          "invariant": {
            "enum": [
              "I1",
              "I2",
              "I3",
              "I4",
              "I5",
              "I6",
              "I7",
              "I8"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "scenario_ref": {
            "type": "string"
          },
          "expect_state": {
            "enum": [
              "idle",
              "safe_stop"
            ]
          },
          "min_delay_ms": {
            "type": "integer",
            "minimum": 0
          },
          "min_accepted_count": {
            "type": "integer",
            "minimum": 0
          },
          "requires": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              0,
              1,
              2,
              3
            ],
            "description": "evidence level this claim needs before it may be confirmed"
          },
          "stale_after_s": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "expect_verdict": {
      "enum": [
        "pass",
        "refute",
        "insufficient"
      ],
      "description": "What a correctly working tool run on this sample looks like. Negative controls expect refute."
    },
    "trace_artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "digests": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "committed_fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "summary"
      ]
    },
    "raw_probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "joint",
          "value"
        ],
        "properties": {
          "joint": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    }
  }
}
